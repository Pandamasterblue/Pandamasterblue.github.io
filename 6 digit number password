#6 digit number
import csv
import random
import time
import string

def guess_pin_sequential(target_pin: str):
    if not target_pin.isdigit():
        raise ValueError("Target PIN must contain only numeric digits.")

    length = len(target_pin)
    target_int = int(target_pin)
    max_combinations = 10**length

    for attempt_num in range(max_combinations):
        if attempt_num == target_int:
            return f"{attempt_num:0{length}d}", attempt_num + 1

    return None, 0


if __name__ == "__main__":
    pin_length = 6
    num_passwords = 250
    csv_filename = "/storage/emulated/0/Download/6_digit_number.csv"

    digits = string.digits

    targets = set()

    while len(targets) < num_passwords:
        pin = "".join(random.choices(digits, k=pin_length))
        targets.add(pin)

    targets = list(targets)

    print(
        f"Running password cracking program for {num_passwords} different "
        f"{pin_length}-digit PINs:\n"
    )

    overall_start = time.perf_counter()

    with open(csv_filename, mode="w", newline="", encoding="utf-8") as file:
        writer = csv.writer(file)

        writer.writerow(["Run Number", "Target PIN", "Attempts", "Time (Seconds)"])

        for index, target in enumerate(targets, start=1):
            run_start = time.perf_counter()

            result, attempts = guess_pin_sequential(target)

            run_time = time.perf_counter() - run_start

            print(
                f"Run {index:3d}/{num_passwords} | "
                f"PIN: {result} | "
                f"Attempts: {attempts:7,d} | "
                f"Time: {run_time:.6f}s"
            )

            writer.writerow([index, result, attempts, round(run_time, 6)])

        total_time = time.perf_counter() - overall_start
        average_time = total_time / num_passwords

        writer.writerow([])
        writer.writerow(["Summary", "Total Runs", "Total Time (s)", "Average Time (s)"])
        writer.writerow(["", num_passwords, round(total_time, 4), round(average_time, 6)])

    print("\n--- Summary ---")
    print(f"Completed {num_passwords} unique runs.")
    print(f"Total time: {total_time:.4f} seconds")
    print(f"Average time per crack: {average_time:.6f} seconds")
    
